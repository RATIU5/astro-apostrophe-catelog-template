---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';

const { widget } = Astro.props;

if (widget.visible === false) {
  return null;
}
---

<section class="faq-section">
  {widget.sectionTitle && <h2>{widget.sectionTitle}</h2>}
  <div class="faq-list">
    {widget.faqs?.map((faq, index) => {
      const headerId = `faq-header-${index}`;
      const panelId = `faq-panel-${index}`;

      return (
        <details class="faq-item">
          <summary
            class="faq-question"
            id={headerId}
            aria-controls={panelId}
          >
            {faq.question}
          </summary>
          <div
            class="faq-answer"
            id={panelId}
            aria-labelledby={headerId}
          >
            <AposArea area={faq.answer} />
          </div>
        </details>
      );
    })}
  </div>
</section>

<style>
  .faq-section {
    margin-bottom: 3rem;
  }

  .faq-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .faq-list {
    max-width: 800px;
  }

  .faq-item {
    border: 1px solid #dbdbdb;
    border-radius: 4px;
    margin-bottom: 1rem;
    background: white;
  }

  .faq-question {
    padding: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    font-weight: 600;
    color: #363636;
    font-size: 1.1rem;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.5rem;
    color: #3273dc;
    transition: transform 0.2s;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  details[open] .faq-question::after {
    content: '−';
    transform: rotate(180deg);
  }

  .faq-question:hover {
    background-color: #f5f5f5;
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem 1.25rem;
    border-top: 1px solid #dbdbdb;
    line-height: 1.6;
    color: #4a4a4a;
  }

  @media (max-width: 768px) {
    .faq-question {
      font-size: 1rem;
      padding: 1rem;
    }

    .faq-answer {
      padding: 0 1rem 1rem 1rem;
    }
  }
</style>
