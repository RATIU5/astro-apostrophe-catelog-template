---
const { widget } = Astro.props;

if (widget.visible === false) {
  return null;
}
---

<section class="cta-section">
  <div class="cta-content">
    <p class="cta-message">{widget.message}</p>
    <a href={widget.buttonUrl} class="cta-button">{widget.buttonText}</a>
  </div>
</section>

<style>
  .cta-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 3rem 2rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .cta-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-message {
    font-size: 1.75rem;
    color: white;
    margin-bottom: 2rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background-color: white;
    color: #667eea;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 700;
    font-size: 1.1rem;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 2rem 1rem;
    }

    .cta-message {
      font-size: 1.25rem;
    }

    .cta-button {
      padding: 0.75rem 2rem;
      font-size: 1rem;
    }
  }
</style>
