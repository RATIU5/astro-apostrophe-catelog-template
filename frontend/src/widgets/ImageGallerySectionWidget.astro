---
import { getAttachmentUrl } from '../lib/attachments.js';

const { widget } = Astro.props;

if (widget.visible === false) {
  return null;
}

const columns = widget.columns || '3';
---

<section class="image-gallery-section">
  {widget.sectionTitle && <h2>{widget.sectionTitle}</h2>}
  <div class={`gallery-grid columns-${columns}`}>
    {widget.galleryImages?.map(item => {
      const image = item.image?.items?.[0]?._image?.[0];
      return image && (
        <figure class="gallery-item">
          <img
            src={getAttachmentUrl(image, { size: 'one-half' })}
            alt={item.caption || ''}
            loading="lazy"
          />
          {item.caption && (
            <figcaption>{item.caption}</figcaption>
          )}
        </figure>
      );
    })}
  </div>
</section>

<style>
  .image-gallery-section {
    margin-bottom: 3rem;
  }

  .image-gallery-section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .gallery-grid {
    display: grid;
    gap: 1.5rem;
  }

  .gallery-grid.columns-2 {
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  }

  .gallery-grid.columns-3 {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .gallery-grid.columns-4 {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  .gallery-item {
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
  }

  .gallery-item img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-item figcaption {
    padding: 1rem;
    text-align: center;
    color: #4a4a4a;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .gallery-grid.columns-2,
    .gallery-grid.columns-3,
    .gallery-grid.columns-4 {
      grid-template-columns: 1fr;
    }

    .gallery-item img {
      height: 250px;
    }
  }
</style>
