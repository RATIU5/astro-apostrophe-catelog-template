---
const { widget } = Astro.props;

if (widget.visible === false) {
  return null;
}

// Get product specifications from the page context
const { piece } = Astro.props.aposData || {};
const specifications = piece?.specifications || [];
const displayStyle = widget.displayStyle || 'table';
---

{specifications.length > 0 && (
  <section class="specifications-display">
    {widget.sectionTitle && <h2>{widget.sectionTitle}</h2>}

    {displayStyle === 'table' && (
      <table class="specs-table">
        <tbody>
          {specifications.map(spec => (
            <tr>
              <th>{spec.key}</th>
              <td>{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {displayStyle === 'list' && (
      <dl class="specs-list">
        {specifications.map(spec => (
          <>
            <dt>{spec.key}</dt>
            <dd>{spec.value}</dd>
          </>
        ))}
      </dl>
    )}

    {displayStyle === 'grid' && (
      <div class="specs-grid">
        {specifications.map(spec => (
          <div class="spec-item">
            <h3>{spec.key}</h3>
            <p>{spec.value}</p>
          </div>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .specifications-display {
    margin-bottom: 3rem;
  }

  .specifications-display h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  /* Table Style */
  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }

  .specs-table th,
  .specs-table td {
    border: 1px solid #dbdbdb;
    padding: 0.75rem;
    text-align: left;
  }

  .specs-table th {
    background-color: #f5f5f5;
    font-weight: 600;
    width: 30%;
  }

  /* List Style */
  .specs-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.5rem;
  }

  .specs-list dt {
    font-weight: 600;
    color: #363636;
  }

  .specs-list dd {
    margin: 0;
    color: #4a4a4a;
  }

  /* Grid Style */
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .spec-item {
    padding: 1.5rem;
    background: #f5f5f5;
    border-radius: 8px;
    border-left: 4px solid #3273dc;
  }

  .spec-item h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #363636;
  }

  .spec-item p {
    margin: 0;
    color: #4a4a4a;
  }

  @media (max-width: 768px) {
    .specs-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
