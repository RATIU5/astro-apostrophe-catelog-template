---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import { getAttachmentUrl } from '../lib/attachments.js';

const { widget } = Astro.props;

// Check visibility
if (widget.visible === false) {
  return null;
}

const backgroundImage = widget.backgroundImage?.items?.[0]?._image?.[0];
---

<section class="hero-section">
  {backgroundImage && (
    <div class="hero-background">
      <img
        src={getAttachmentUrl(backgroundImage, { size: 'full' })}
        alt=""
        aria-hidden="true"
      />
    </div>
  )}
  <div class="hero-content">
    <h2>{widget.heading}</h2>
    {widget.subheading && <p class="subheading">{widget.subheading}</p>}
    {widget.ctaText && widget.ctaUrl && (
      <a href={widget.ctaUrl} class="cta-button">{widget.ctaText}</a>
    )}
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    padding: 2rem;
    max-width: 800px;
  }

  .hero-content h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: white;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .hero-content .subheading {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    line-height: 1.6;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #3273dc;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .cta-button:hover {
    background-color: #2366d1;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 350px;
    }

    .hero-content h2 {
      font-size: 2rem;
    }

    .hero-content .subheading {
      font-size: 1rem;
    }
  }
</style>
