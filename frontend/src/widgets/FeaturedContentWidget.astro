---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import { getAttachmentUrl } from '../lib/attachments.js';

const { widget } = Astro.props;

if (widget.visible === false) {
  return null;
}

const featuredImage = widget.featuredImage?.items?.[0]?._image?.[0];
const imagePosition = widget.imagePosition || 'left';
---

<section class={`featured-content position-${imagePosition}`}>
  <div class="featured-content-wrapper">
    {featuredImage && (
      <div class="featured-image">
        <img
          src={getAttachmentUrl(featuredImage, { size: 'one-half' })}
          alt=""
          loading="lazy"
        />
      </div>
    )}
    <div class="featured-text">
      <h2>{widget.title}</h2>
      {widget.content && (
        <div class="content-area">
          <AposArea area={widget.content} />
        </div>
      )}
      {widget.ctaText && widget.ctaUrl && (
        <a href={widget.ctaUrl} class="cta-button">{widget.ctaText}</a>
      )}
    </div>
  </div>
</section>

<style>
  .featured-content {
    margin-bottom: 3rem;
    background: #f5f5f5;
    border-radius: 8px;
    overflow: hidden;
  }

  .featured-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 400px;
  }

  /* Image position variations */
  .featured-content.position-left .featured-content-wrapper {
    grid-template-columns: 1fr 1fr;
  }

  .featured-content.position-right .featured-content-wrapper {
    grid-template-columns: 1fr 1fr;
  }

  .featured-content.position-right .featured-image {
    order: 2;
  }

  .featured-content.position-top .featured-content-wrapper {
    grid-template-columns: 1fr;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-text {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: white;
  }

  .featured-text h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #363636;
  }

  .content-area {
    margin-bottom: 2rem;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #3273dc;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background-color 0.2s;
    align-self: flex-start;
  }

  .cta-button:hover {
    background-color: #2366d1;
  }

  @media (max-width: 768px) {
    .featured-content-wrapper,
    .featured-content.position-left .featured-content-wrapper,
    .featured-content.position-right .featured-content-wrapper {
      grid-template-columns: 1fr;
    }

    .featured-content.position-right .featured-image {
      order: 0;
    }

    .featured-text {
      padding: 2rem;
    }

    .featured-text h2 {
      font-size: 1.5rem;
    }

    .featured-image {
      height: 300px;
    }
  }
</style>
