---
import AposLayout from '@apostrophecms/apostrophe-astro/components/layouts/AposLayout.astro';
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import { getAttachmentUrl } from '../lib/attachments.js';

const { piece } = Astro.props.aposData;
const primaryImage = piece.images?.find(img => img.isPrimary) || piece.images?.[0];
const otherImages = piece.images?.filter(img => !img.isPrimary) || [];
const category = piece._category?.[0];
const startingPrice = piece.variants?.length > 0
  ? Math.min(...piece.variants.map(v => v.price))
  : null;
---

<AposLayout title={piece.title} {...Astro.props}>
  <Fragment slot="main">
    <article class="product-page">
      <!-- Product Header -->
      <header class="product-header">
        <h1>{piece.title}</h1>
      </header>

      <!-- Main Content Grid -->
      <div class="product-content">
        <!-- Image Gallery -->
        <section class="product-gallery">
          {primaryImage && (
            <div class="primary-image">
              <img
                src={getAttachmentUrl(primaryImage.image?.items?.[0]?._image?.[0], { size: 'full' })}
                alt={primaryImage.altText || piece.title}
              />
            </div>
          )}
          {otherImages.length > 0 && (
            <div class="thumbnail-grid">
              {otherImages.slice(0, 14).map(img => (
                <img
                  src={getAttachmentUrl(img.image?.items?.[0]?._image?.[0], { size: 'one-sixth' })}
                  alt={img.altText || piece.title}
                  class="thumbnail"
                />
              ))}
            </div>
          )}
        </section>

        <!-- Product Info -->
        <section class="product-info">
          <!-- Description -->
          {piece.description && (
            <div class="product-description">
              <h2>Description</h2>
              <AposArea area={piece.description} />
            </div>
          )}

          <!-- Product Options -->
          {piece.productOptions?.length > 0 && (
            <div class="product-options">
              <h2>Available Options</h2>
              <div class="options-list">
                {piece.productOptions.map(option => {
                  const values = option.values?.split(',').map(v => v.trim()).filter(v => v) || [];
                  return (
                    <div class="option">
                      <strong>{option.name}:</strong>
                      <span class="option-values">{values.join(', ')}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Variants Selector -->
          {piece.variants?.length > 0 && (
            <div class="product-variants">
              <h2>Product Variants</h2>
              {startingPrice && <p class="starting-price">Starting at ${startingPrice.toFixed(2)}</p>}
              <div class="variants-list">
                {piece.variants.map(variant => {
                  const isAvailable = variant.available !== false;
                  const inStock = variant.quantity > 0;
                  const hasDiscount = variant.compareAtPrice && variant.compareAtPrice > variant.price;

                  return (
                    <div class={`variant ${!isAvailable ? 'unavailable' : ''} ${!inStock ? 'out-of-stock' : ''}`}>
                      <div class="variant-info">
                        <div class="variant-options">
                          {variant.optionValues?.map(opt => (
                            <span class="option-badge">{opt.optionName}: {opt.value}</span>
                          ))}
                        </div>
                        <div class="variant-pricing">
                          {hasDiscount && (
                            <span class="compare-price">${variant.compareAtPrice.toFixed(2)}</span>
                          )}
                          <span class="price">${variant.price.toFixed(2)}</span>
                          {hasDiscount && (
                            <span class="discount-badge">
                              {Math.round((1 - variant.price / variant.compareAtPrice) * 100)}% OFF
                            </span>
                          )}
                        </div>
                        <div class="variant-meta">
                          <span class="sku">SKU: {variant.sku}</span>
                          {variant.barcode && (
                            <span class="barcode">Barcode: {variant.barcode}</span>
                          )}
                          {variant.weight && (
                            <span class="weight">Weight: {variant.weight} lbs</span>
                          )}
                        </div>
                      </div>
                      <div class="variant-status">
                        {!isAvailable && (
                          <span class="status-badge unavailable">Unavailable</span>
                        )}
                        {isAvailable && !inStock && (
                          <span class="status-badge out-of-stock">Out of Stock</span>
                        )}
                        {isAvailable && inStock && (
                          <span class="status-badge in-stock">
                            {variant.quantity} in stock
                          </span>
                        )}
                        {variant.requiresShipping === false && (
                          <span class="status-badge digital">Digital</span>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Specifications -->
          {piece.specifications?.length > 0 && (
            <div class="product-specs">
              <h2>Specifications</h2>
              <dl class="specs-list">
                {piece.specifications.map(spec => (
                  <>
                    <dt>{spec.key}</dt>
                    <dd>{spec.value}</dd>
                  </>
                ))}
              </dl>
            </div>
          )}

          <!-- Information Table -->
          {piece.informationTable?.tableTitle && (
            <div class="information-table">
              <h2>{piece.informationTable.tableTitle}</h2>
              <table>
                <thead>
                  <tr>
                    <th></th>
                    {piece.informationTable.columnNames?.map(col => (
                      <th>{col.name}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {piece.informationTable.rowNames?.map((row, rowIdx) => (
                    <tr>
                      <th>{row.name}</th>
                      {piece.informationTable.columnNames?.map((col, colIdx) => {
                        const cellData = piece.informationTable.cellData?.find(
                          cell => cell.rowIndex === rowIdx && cell.columnIndex === colIdx
                        );
                        return <td>{cellData?.value || ''}</td>;
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <!-- Features -->
          {piece.features && (
            <div class="product-features">
              <h2>Features</h2>
              <AposArea area={piece.features} />
            </div>
          )}
        </section>
      </div>

      <!-- Dynamic Sections (added by editors) -->
      {piece.sections && (
        <div class="dynamic-sections">
          <AposArea area={piece.sections} />
        </div>
      )}
    </article>
  </Fragment>
</AposLayout>

<style>
  .product-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .product-header {
    margin-bottom: 2rem;
  }

  .product-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .product-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .product-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .product-gallery .primary-image {
    width: 100%;
    margin-bottom: 1rem;
  }

  .product-gallery .primary-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.5rem;
  }

  .thumbnail {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .thumbnail:hover {
    border-color: #3273dc;
  }

  .product-info h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .product-description,
  .product-options,
  .product-variants,
  .product-specs,
  .information-table,
  .product-features {
    margin-bottom: 2rem;
  }

  /* Product Options */
  .options-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background: #f5f5f5;
    border-radius: 4px;
  }

  .option {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .option strong {
    min-width: 100px;
    color: #363636;
  }

  .option-values {
    color: #4a4a4a;
  }

  /* Variants */
  .starting-price {
    font-size: 1.25rem;
    font-weight: bold;
    color: #3273dc;
    margin-bottom: 1rem;
  }

  .variants-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .variant {
    padding: 1.25rem;
    border: 2px solid #dbdbdb;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: white;
    transition: border-color 0.2s;
  }

  .variant:hover {
    border-color: #3273dc;
  }

  .variant.unavailable {
    opacity: 0.6;
    background: #f5f5f5;
  }

  .variant.out-of-stock {
    border-color: #ff9800;
  }

  .variant-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #e8f4fd;
    color: #3273dc;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .variant-pricing {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .variant-pricing .price {
    font-size: 1.5rem;
    font-weight: bold;
    color: #363636;
  }

  .variant-pricing .compare-price {
    font-size: 1.125rem;
    color: #7a7a7a;
    text-decoration: line-through;
  }

  .discount-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: #48c774;
    color: white;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: bold;
  }

  .variant-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.875rem;
    color: #7a7a7a;
  }

  .variant-meta .sku {
    font-weight: 500;
    color: #4a4a4a;
  }

  .variant-status {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .status-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .status-badge.in-stock {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .status-badge.out-of-stock {
    background: #fff3e0;
    color: #e65100;
  }

  .status-badge.unavailable {
    background: #f5f5f5;
    color: #7a7a7a;
  }

  .status-badge.digital {
    background: #e3f2fd;
    color: #1976d2;
  }

  @media (max-width: 768px) {
    .variant {
      flex-direction: column;
      gap: 1rem;
    }

    .variant-status {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .specs-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
  }

  .specs-list dt {
    font-weight: bold;
  }

  .specs-list dd {
    margin: 0;
  }

  .information-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }

  .information-table th,
  .information-table td {
    border: 1px solid #dbdbdb;
    padding: 0.75rem;
    text-align: left;
  }

  .information-table thead th {
    background-color: #f5f5f5;
    font-weight: bold;
  }

  .information-table tbody th {
    background-color: #fafafa;
    font-weight: bold;
  }

  .dynamic-sections {
    margin-top: 3rem;
  }
</style>
