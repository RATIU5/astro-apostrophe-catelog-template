---
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';

const { page } = Astro.props.aposData;
const { main } = page;
---
<div class="main-content astro-hp-content">
  {/* Home Page Sections Area */}
  {main && (
    <div class="home-sections">
      <AposArea area={main} />
    </div>
  )}
</div>

<style>
  .main-content {
    width: 100%;
  }

  .home-sections {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>