---
import AposLayout from '@apostrophecms/apostrophe-astro/components/layouts/AposLayout.astro';
import AposArea from '@apostrophecms/apostrophe-astro/components/AposArea.astro';
import { getAttachmentUrl } from '../lib/attachments.js';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const { piece } = Astro.props.aposData;
const parentCategory = piece._parentCategory?.[0];
const categoryImage = piece.image?.items?.[0]?._image?.[0];

const aposHost = import.meta.env.APOS_HOST || 'http://localhost:3000';

// Check if this category has sub-categories
const subCategoriesResponse = await fetch(
  `${aposHost}/api/v1/category?_parentCategory=${piece._id}`,
  {
    headers: {
      'Content-Type': 'application/json'
    }
  }
);
const subCategoriesData = await subCategoriesResponse.json();
const subCategories = subCategoriesData.results || [];

// If there are no sub-categories, get products for this category directly
let directProducts = [];
if (subCategories.length === 0) {
  const productsResponse = await fetch(
    `${aposHost}/api/v1/product?_category=${piece._id}`,
    {
      headers: {
        'Content-Type': 'application/json'
      }
    }
  );
  const productsData = await productsResponse.json();
  directProducts = productsData.results || [];
}

// If there are sub-categories, fetch products for each sub-category
const subCategoriesWithProducts = await Promise.all(
  subCategories.map(async (subCategory) => {
    const productsResponse = await fetch(
      `${aposHost}/api/v1/product?_category=${subCategory._id}`,
      {
        headers: {
          'Content-Type': 'application/json'
        }
      }
    );
    const productsData = await productsResponse.json();
    return {
      ...subCategory,
      products: productsData.results || []
    };
  })
);

console.log(JSON.stringify(piece.image?.items?.[0], null, 2));
---

<AposLayout title={piece.title} {...Astro.props}>
  <Fragment slot="main">
    <article class="max-w-7xl mx-auto px-4 py-8">
      <!-- Category Header -->
      <header class="mb-12">
        {categoryImage && (
          <div class="w-full h-96 overflow-hidden rounded-lg mb-8">
            <img
              src={getAttachmentUrl(categoryImage, { size: 'full' })}
              alt={piece.title}
              class="w-full h-full object-cover"
            />
          </div>
        )}
        <div>
          <h1 class="text-4xl mb-4">{piece.title}</h1>
          {parentCategory && (
            <nav class="flex items-center gap-2 mb-6 text-sm" aria-label="breadcrumbs">
              <a href={parentCategory._url} class="text-blue-600 hover:underline">{parentCategory.title}</a>
              <span aria-hidden="true" class="text-gray-400">›</span>
              <span aria-current="page" class="text-gray-500">{piece.title}</span>
            </nav>
          )}
          {piece.description && (
            <div class="text-lg leading-relaxed text-gray-700">
              <AposArea area={piece.description} />
            </div>
          )}
        </div>
      </header>

      <!-- Sub-Categories with Products (if this is a parent category) -->
      {subCategoriesWithProducts.length > 0 && subCategoriesWithProducts.map(subCategory => (
        subCategory.products.length > 0 && (
          <section class="mb-12">
            <h2 class="text-3xl mb-8">{subCategory.title}</h2>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-8">
              {subCategory.products.map(product => {
                const startingPrice = product.variants?.length > 0
                  ? Math.min(...product.variants.map(v => v.price))
                  : null;

                return (
                  <article class="border border-gray-300 rounded-lg overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                    <a href={product._url} class="no-underline text-inherit block">
                      {product.images?.items[0] && (
                        <div class="w-full h-64 overflow-hidden">
                          <ResponsiveImage
                            image={product.images.items[0]._image?.[0]}
                            alt={product.title}
                            class="w-full h-full object-cover"
                          />
                        </div>
                      )}
                      <div class="p-6">
                        <h3 class="text-xl mb-2 text-gray-800">{product.title}</h3>
                        {startingPrice && (
                          <p class="text-lg font-bold text-blue-600 m-0">From ${startingPrice.toFixed(2)}</p>
                        )}
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          </section>
        )
      ))}

      <!-- Direct Products (if this is a leaf category with no sub-categories) -->
      {directProducts.length > 0 && (
        <section class="mb-12">
          <h2 class="text-3xl mb-8">Products</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-8 md:gap-4 md:grid-cols-[repeat(auto-fill,minmax(200px,1fr))]">
            {directProducts.map(product => {
              const primaryImage = product.images?.items[0];
              const startingPrice = product.variants?.length > 0
                ? Math.min(...product.variants.map(v => v.price))
                : null;

              return (
                <article class="border border-gray-300 rounded-lg overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                  <a href={product._url} class="no-underline text-inherit block">
                    {primaryImage && (
                      <div class="w-full h-64 overflow-hidden">
                        <ResponsiveImage
                          image={primaryImage._image?.[0]}
                          alt={primaryImage.altText || product.title}
                          class="w-full h-full object-cover"
                        />
                      </div>
                    )}
                    <div class="p-6">
                      <h3 class="text-xl mb-2 text-gray-800">{product.title}</h3>
                      {startingPrice && (
                        <p class="text-lg font-bold text-blue-600 m-0">From ${startingPrice.toFixed(2)}</p>
                      )}
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <!-- Dynamic Sections -->
      {piece.sections && (
        <div class="mt-12">
          <AposArea area={piece.sections} />
        </div>
      )}
    </article>
  </Fragment>
</AposLayout>
